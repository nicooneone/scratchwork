# Copy to .env.local and fill in. Never commit .env.local. Never prefix keys with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional: override the models (check Google AI Studio for the latest Flash).
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
ELEVENLABS_API_KEY=
# A premade ElevenLabs voice id.
ELEVENLABS_VOICE_ID=
