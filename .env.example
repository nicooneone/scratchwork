# Copy to .env.local and fill in. Never commit .env.local. Never prefix keys with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional: override the models (gemini-2.5-* returns 404 for new keys).
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
ELEVENLABS_API_KEY=
# A premade ElevenLabs voice id.
ELEVENLABS_VOICE_ID=
